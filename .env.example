# Copy to .env and adjust. `make app-up` passes this file to the API container (docker/podman --env-file):
# write plain KEY=value lines, without quotes or `export`.
# If .env does not exist, `make app-up` points the API to the local cocos-postgres and cocos-redis containers.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://cocos-postgres:5432/cocos
DB_USER=postgres
DB_PASSWORD=postgres
# Cloud example (managed PostgreSQL with TLS):
# DB_URL=jdbc:postgresql://my-db.example.com:5432/cocos?sslmode=require
# DB_USER=cocos_app
# DB_PASSWORD=change-me

# --- Cache ---
# redis (default) | memory (in-process, no Redis needed) | none (cache disabled)
CACHE_TYPE=redis
REDIS_HOST=cocos-redis
REDIS_PORT=6379
REDIS_SSL=false
# Cloud example (managed Redis with TLS and password):
# REDIS_HOST=my-cache.example.com
# REDIS_PORT=6380
# REDIS_SSL=true
# SPRING_DATA_REDIS_USERNAME=default
# SPRING_DATA_REDIS_PASSWORD=change-me
# Or a single URL (overrides host/port/ssl/user/password):
# SPRING_DATA_REDIS_URL=rediss://default:change-me@my-cache.example.com:6380

# --- API documentation (Swagger UI + /v3/api-docs) ---
# API_DOCS_ENABLED=false

# --- Observability (OpenTelemetry Java agent bundled in the image) ---
# Local stack started by `make obs-up` (Grafana on http://localhost:3000):
OTEL_EXPORTER_OTLP_ENDPOINT=http://cocos-otel:4318
# OTEL_SERVICE_NAME=cocos-api
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=cocos,deployment.environment.name=local
# Disable the agent completely:
# OTEL_JAVAAGENT_ENABLED=false
#
# New Relic (OTLP endpoint, license key as header):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_HEADERS=api-key=YOUR_NEW_RELIC_LICENSE_KEY
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=cocos,deployment.environment.name=production
#
# Datadog (through a Datadog Agent with OTLP ingestion enabled, DD_OTLP_CONFIG_RECEIVER_PROTOCOLS_HTTP_ENDPOINT=0.0.0.0:4318):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://datadog-agent:4318
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=cocos,deployment.environment.name=production,service.version=1.0.0
#
# Grafana Cloud (OTLP gateway, basic auth "instanceId:token" in base64):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic BASE64_INSTANCE_ID_AND_TOKEN

# --- Cache TTLs (ISO-8601 or 10m / 1h style durations) ---
# APP_CACHE_TTL_USERS=1h
# APP_CACHE_TTL_INSTRUMENTS=1h
# APP_CACHE_TTL_INSTRUMENT_SEARCH=10m
# APP_CACHE_TTL_MARKETDATA=1m
# APP_CACHE_TTL_PORTFOLIO=5m
# APP_CACHE_TTL_PORTFOLIO_GENERATION=1d
