{
  "info": {
    "name": "Cocos Challenge API",
    "description": "Portfolio, instrument search and orders. Examples use the seed in database.sql (user 1, PAMP = instrument 47, ARS = instrument 66). Set `baseUrl` if the API is not on localhost:8080. The OpenAPI document is at /v3/api-docs and Swagger UI at /swagger-ui.html.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Portfolio",
      "description": "Cash and positions of a user, derived from their orders.",
      "item": [
        {
          "name": "Portfolio of user 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has positions\", () => pm.expect(pm.response.json().positions).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/portfolio/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "portfolio",
                "1"
              ]
            },
            "description": "Total account value, cash available to trade and positions (FILLED orders, weighted average cost). Seed user 1: balance 753,000; pending LIMIT buys reserve 125,500 → available 627,500."
          },
          "response": [
            {
              "name": "200 - User 1 (seed)",
