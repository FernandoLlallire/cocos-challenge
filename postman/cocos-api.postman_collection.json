    {
      "name": "Orders",
      "description": "Send orders and cancel pending ones. A business rejection (insufficient cash or shares) is stored with status REJECTED and still returns 201: check `status`. Malformed requests return 400 and are not stored.",
      "item": [
        {
          "name": "MARKET buy by size",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Order status is FILLED\", () => pm.expect(pm.response.json().status).to.eql(\"FILLED\"));",
                  "pm.collectionVariables.set(\"lastOrderId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Executes at the latest close (PAMP 925.85) -> FILLED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 47,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 10\n}",
